# Same service secret as the NestJS API; supply via process environment or --env-file.
AI_SERVICE_KEY=
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
# Optional paid Neon Gateway. Default remains lightweight (or Ollama when configured).
# Explicitly set AI_PROVIDER=neon only after choosing a catalog model and a usage budget.
# Neon requires a paid plan and prepaid credits; these values stay on the Python server.
# AI_PROVIDER=neon
# NEON_AI_GATEWAY_BASE_URL=https://your-branch-api.ai.your-region.aws.neon.tech
# NEON_AI_GATEWAY_TOKEN=
# NEON_AI_GATEWAY_MODEL=
# Use AI_PROVIDER=lightweight to disable all instruction-model calls.
# Optional, separately downloaded model assets. No model is downloaded at startup.
# OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL_PATH=C:/SammTech/models/all-MiniLM-L6-v2
# WHISPER_MODEL_PATH=C:/SammTech/models/faster-whisper-base.en
# PIPER_MODEL_PATH=C:/SammTech/models/en_US-lessac-medium.onnx
