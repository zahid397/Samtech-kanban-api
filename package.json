{
  "name": "sammtech-kanban-api",
  "version": "1.0.0",
  "description": "SammTech AI OS — authorized Kanban, Python intelligence, voice, agents and persistent automation.",
  "author": "Zahid",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:debug": "node --inspect -r ts-node/register src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "test:integration": "node --require ts-node/register --test test/integration/*.test.ts",
    "verify": "node scripts/verify.cjs",
    "verify:all": "node scripts/verify.cjs --integration"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.6",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.62.1",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    }
  }
}
